generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cocktail {
  id          Int      @id @default(autoincrement())
  name        String
  taste       String
  createdAt   DateTime @default(now()) // Automatischer Zeitstempel
  rating      Float
  ingredients Itemlist[]
}

model Item {
  id          Int      @id @default(autoincrement())
  name        String
  cocktails   Itemlist[]
}

model Itemlist {
  cocktail    Cocktail @relation(fields: [cocktail_id], references: [id])
  cocktail_id Int 
  item        Item     @relation(fields: [item_id], references: [id])
  item_id     Int

  amount      String

  @@id([cocktail_id, item_id])
}