// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Hier definieren wir deine Rezept-Tabelle als JavaScript-Schnittstelle
model Recipe {
  id          Int      @id @default(autoincrement()) // SERIAL PRIMARY KEY
  title       String   // VARCHAR
  ingredients String[] // Ein Array aus Texten (Postgres unterstützt das nativ!)
  steps       String[]
  createdAt   DateTime @default(now()) // Automatischer Zeitstempel

  @@map("recipes") // Sorgt dafür, dass die Tabelle in der DB klein geschrieben "recipes" heißt
}